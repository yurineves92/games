rules_version = '2';

// Regras do Hall da Fama da Super Neon.
// Qualquer um lê o ranking; só dá para criar placares novos, no formato certo.
// Ninguém edita nem apaga placar pelo site.
service cloud.firestore {
  match /databases/{database}/documents {
    match /ranking/{board}/scores/{scoreId} {
      allow read: if board.matches('^[a-z0-9-]{1,40}$');
      allow create: if board.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score < 10000000
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
